# ─── Etherscan ───────────────────────────────────────────────────────────────
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development              # development | production
MAX_NODES=500
MAX_DEPTH=10
TRACE_TIMEOUT_SECONDS=30

# ─── Rate limiting ───────────────────────────────────────────────────────────
ETHERSCAN_MAX_CALLS_PER_SEC=5   # Free tier limit
ETHERSCAN_MAX_TX_PER_WALLET=100 # Rolling window cap (real-time performance)

# ─── Model ───────────────────────────────────────────────────────────────────
MODEL_PATH=data/processed/model.pkl
FEATURES_CONFIG_PATH=data/processed/features_15.json
